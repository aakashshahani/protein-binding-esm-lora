# Copy to .env and fill in. .env is gitignored.

# Weights & Biases. Default is OFFLINE logging (no account needed); runs are
# written to ./wandb and can be synced later with `wandb sync`.
WANDB_MODE=offline
WANDB_PROJECT=protein-binding-esm-lora
# WANDB_ENTITY=your-entity        # only needed if you switch WANDB_MODE=online
# WANDB_API_KEY=xxxxxxxxxxxxxxxx   # only needed for online mode

# Where big artifacts live (all gitignored)
PBSITE_DATA_DIR=./data
PBSITE_EMB_DIR=./embeddings
PBSITE_OUT_DIR=./outputs

# HuggingFace cache (optional)
# HF_HOME=./.hf_cache
